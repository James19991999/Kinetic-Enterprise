# ---- Firebase (client) ----
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ---- Firebase Admin (server only, never exposed to client) ----
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
# Use \n literal newlines when pasting into .env.local
FIREBASE_ADMIN_PRIVATE_KEY=

# ---- Stripe ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_BASIC=
STRIPE_PRICE_PRO=
STRIPE_PRICE_ENTERPRISE=

# ---- App ----
NEXT_PUBLIC_APP_URL=http://localhost:3000
SESSION_COOKIE_NAME=__workpulse_session

# ---- Rate limiting (optional) ----
# When both are set, /api/login and /api/signup are rate-limited via Upstash
# Redis, which is safe across multiple serverless instances. When either is
# missing, the app falls back to an in-memory limiter (fine for local dev or
# a single-instance deployment, not for production at scale). Get these from
# https://console.upstash.com after creating a free Redis database.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---- Metrics aggregation cron ----
# Protects GET /api/cron/aggregate-metrics, which rolls up pulseEntries into
# metricsSummaries on a schedule (see vercel.json). Generate any random
# string (e.g. `openssl rand -hex 32`) and set the same value on your
# hosting provider. On Vercel, setting CRON_SECRET automatically makes
# Vercel Cron send it as `Authorization: Bearer <value>`.
CRON_SECRET=
